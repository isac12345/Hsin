#!/system/bin/sh
# HSIN Universal Performance - update-binary
# Magisk/KernelSU/APatch compatible installer

MODPATH="$2"
ZIPFILE="$3"
MODULE_ID="hsin"

LOGDIR=/data/adb/${MODULE_ID}
LOGFILE=$LOGDIR/update-binary.log
mkdir -p "$LOGDIR" 2>/dev/null
echo "=== HSIN update-binary $(date) ===" > "$LOGFILE" 2>/dev/null

log() {
    echo "[$(date '+%H:%M:%S')] [BIN] $1" >> "$LOGFILE" 2>/dev/null
}

log "Modpath: $MODPATH"
log "Zipfile: $ZIPFILE"

# Extract all module files to MODPATH
unzip -o "$ZIPFILE" 'core/*' -d "$MODPATH" >&2
unzip -o "$ZIPFILE" 'engine/*' -d "$MODPATH" >&2
unzip -o "$ZIPFILE" 'profiles/*' -d "$MODPATH" >&2
unzip -o "$ZIPFILE" 'config/*' -d "$MODPATH" >&2
unzip -o "$ZIPFILE" 'bin/*' -d "$MODPATH" >&2
unzip -o "$ZIPFILE" 'extreme/*' -d "$MODPATH" >&2
unzip -o "$ZIPFILE" 'assets/*' -d "$MODPATH" >&2
unzip -o "$ZIPFILE" 'module.prop' -d "$MODPATH" >&2
unzip -o "$ZIPFILE" 'customize.sh' -d "$MODPATH" >&2
unzip -o "$ZIPFILE" 'service.sh' -d "$MODPATH" >&2
unzip -o "$ZIPFILE" 'post-fs-data.sh' -d "$MODPATH" >&2
unzip -o "$ZIPFILE" 'uninstall.sh' -d "$MODPATH" >&2

# Set permissions
set_perm_recursive "$MODPATH" 0 0 0755 0644
set_perm "$MODPATH/service.sh" 0 0 0755
set_perm "$MODPATH/post-fs-data.sh" 0 0 0755
set_perm "$MODPATH/customize.sh" 0 0 0755
set_perm "$MODPATH/uninstall.sh" 0 0 0755
[ -f "$MODPATH/bin/hsin" ] && set_perm "$MODPATH/bin/hsin" 0 0 0755
[ -f "$MODPATH/bin/hsin-cli" ] && set_perm "$MODPATH/bin/hsin-cli" 0 0 0755
[ -f "$MODPATH/bin/hsin-verify" ] && set_perm "$MODPATH/bin/hsin-verify" 0 0 0755
[ -f "$MODPATH/bin/hsin-verify-full" ] && set_perm "$MODPATH/bin/hsin-verify-full" 0 0 0755
set_perm_recursive "$MODPATH/core" 0 0 0755 0644
set_perm_recursive "$MODPATH/engine" 0 0 0755 0644
set_perm_recursive "$MODPATH/profiles" 0 0 0755 0644
set_perm_recursive "$MODPATH/config" 0 0 0755 0644

# Run customize
if [ -f "$MODPATH/customize.sh" ]; then
    log "Running customize.sh"
    sh "$MODPATH/customize.sh"
fi

log "update-binary complete"
exit 0

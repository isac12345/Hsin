<resources>
    <style name="Theme.Hsin" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/hsin_primary</item>
        <item name="colorPrimaryContainer">@color/hsin_primary_container</item>
        <item name="colorSecondary">@color/hsin_secondary</item>
        <item name="colorSecondaryContainer">@color/hsin_secondary_container</item>
        <item name="colorTertiary">@color/hsin_tertiary</item>
        <item name="colorTertiaryContainer">@color/hsin_tertiary_container</item>
        <item name="colorSurface">@color/hsin_surface</item>
        <item name="colorSurfaceVariant">@color/hsin_surface_variant</item>
        <item name="android:colorBackground">@color/hsin_background</item>
        <item name="colorError">@color/hsin_error</item>
        <item name="colorOnPrimary">@color/hsin_on_primary</item>
        <item name="colorOnPrimaryContainer">@color/hsin_on_primary_container</item>
        <item name="colorOnSecondary">@color/hsin_on_secondary</item>
        <item name="colorOnSecondaryContainer">@color/hsin_on_secondary_container</item>
        <item name="colorOnTertiary">@color/hsin_on_tertiary</item>
        <item name="colorOnTertiaryContainer">@color/hsin_on_tertiary_container</item>
        <item name="colorOnSurface">@color/hsin_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/hsin_on_surface_variant</item>
        <item name="colorOnBackground">@color/hsin_on_background</item>
        <item name="colorOnError">@color/hsin_on_error</item>
        <item name="colorOutline">@color/hsin_outline</item>
        <item name="colorOutlineVariant">@color/hsin_outline_variant</item>
        <item name="colorSurfaceInverse">@color/hsin_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/hsin_inverse_on_surface</item>
        <item name="android:statusBarColor">@color/hsin_surface</item>
        <item name="android:navigationBarColor">@color/hsin_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.Hsin.AppBarOverlay" parent="ThemeOverlay.Material3.Dark.ActionBar" />

    <style name="Theme.Hsin.PopupOverlay" parent="ThemeOverlay.Material3.Light" />

    <style name="SectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="InfoRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
</resources>
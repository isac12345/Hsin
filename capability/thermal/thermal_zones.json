{
  "name": "thermal_zones",
  "type": "thermal",
  "description": "Linux thermal zone framework (generic, all vendors)",
  "priority": 1,
  "fallback": "thermal_hal",
  "features": {
    "zones": {
      "required": true,
      "description": "Thermal zone sensors available",
      "detection_paths": ["/sys/class/thermal/thermal_zone*"]
    },
    "temperature": {
      "required": true,
      "description": "Can read current temperature",
      "detection_paths": ["/sys/class/thermal/thermal_zone*/temp"]
    },
    "trip_point": {
      "required": false,
      "description": "Can read/modify trip points",
      "detection_paths": ["/sys/class/thermal/thermal_zone*/trip_point_*_temp"]
    },
    "cooling_device": {
      "required": false,
      "description": "Cooling devices available",
      "detection_paths": ["/sys/class/thermal/cooling_device*"]
    },
    "policy": {
      "required": false,
      "description": "Thermal zone policy/governor",
      "detection_paths": ["/sys/class/thermal/thermal_zone*/policy"]
    },
    "throttle_control": {
      "required": false,
      "description": "Can adjust throttling behavior",
      "detection_paths": ["/sys/class/thermal/thermal_zone*/sustainable_power"]
    }
  },
  "detection": {
    "method": "glob",
    "pattern": "/sys/class/thermal/thermal_zone*",
    "expected_min_count": 1
  },
  "paths": [
    "/sys/class/thermal/thermal_zone*/temp",
    "/sys/class/thermal/thermal_zone*/type",
    "/sys/class/thermal/thermal_zone*/policy",
    "/sys/class/thermal/thermal_zone*/trip_point_*_temp",
    "/sys/class/thermal/thermal_zone*/trip_point_*_type",
    "/sys/class/thermal/thermal_zone*/sustainable_power",
    "/sys/class/thermal/cooling_device*/type",
    "/sys/class/thermal/cooling_device*/cur_state",
    "/sys/class/thermal/cooling_device*/max_state"
  ],
  "writable_check": {
    "test_node": "auto",
    "strategy": "find_writable",
    "candidates": [
      "/sys/class/thermal/thermal_zone0/sustainable_power"
    ],
    "read_before_write": true,
    "restore_after_write": true,
    "never_disable": true
  },
  "safety": {
    "never_disable_thermal": true,
    "min_trip_point_delta": 5000,
    "max_temp_override": 95000,
    "description": "Thermal MUST always remain active. Only threshold adjustment allowed."
  },
  "engines": [
    {
      "name": "thermal_zone_tune",
      "priority": 1,
      "description": "Thermal zone threshold adjustment (safe mode only)",
      "method": "direct_write",
      "requires": ["zones", "trip_point"],
      "safety": "threshold_only"
    }
  ]
}

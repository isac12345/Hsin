{
  "name": "Thermal Safe Policy",
  "enabled": false,
  "detect_nodes": [
    "/sys/class/thermal/thermal_zone0"
  ],
  "required_nodes": [
    "trip_point_0_temp"
  ],
  "optional_nodes": [
    "trip_point_1_temp",
    "sustainable_power",
    "passive"
  ],
  "write_support": true,
  "risk_level": "low",
  "engine_priority": 95,
  "safety": {
    "description": "Safe thermal policy: only adjust thresholds, never disable thermal",
    "allowed_operations": ["increase_trip_point", "set_sustainable_power"],
    "forbidden_operations": ["disable_thermal", "set_trip_point_below_current"]
  }
}

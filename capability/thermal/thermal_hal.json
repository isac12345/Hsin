{
  "name": "Android Thermal HAL",
  "enabled": false,
  "detect_nodes": [
    "/sys/devices/virtual/thermal/thermal_message",
    "/sys/kernel/eara_thermal",
    "/proc/mtk_batoc_throttling"
  ],
  "required_nodes": [],
  "optional_nodes": [
    "thermal_message/cpu_limits",
    "eara_thermal/enable",
    "mtk_batoc_throttling/battery_oc_protect_stop"
  ],
  "write_support": true,
  "risk_level": "high",
  "engine_priority": 80,
  "safety": {
    "never_disable": true,
    "never_stop_battery_oc": true
  }
}

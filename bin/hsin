#!/system/bin/sh
# HSIN CLI - Main Entry Point
# Usage: hsin <command> [args]

[ -z "$HSIN_MODULE_PATH" ] && HSIN_MODULE_PATH="/data/adb/modules/hsin"
HSIN_DATA="${HSIN_DATA:-/data/adb/hsin}"

# Load core modules
. "$HSIN_MODULE_PATH/core/logger.sh" 2>/dev/null
. "$HSIN_MODULE_PATH/core/root_check.sh" 2>/dev/null

# Version
HSIN_VERSION="5.0.0-beta1"

# Show help
hsin_help() {
    echo ""
    echo "╔══════════════════════════════════════╗"
    echo "║   HSIN Universal Adaptive Perf v${HSIN_VERSION}  ║"
    echo "╚══════════════════════════════════════╝"
    echo ""
    echo "Usage: hsin <command> [args]"
    echo ""
    echo "Core Commands:"
    echo "  detect              Hardware info (no root needed)"
    echo "  scan                Capability scan (auto-detect root)"
    echo "  apply <profile>     Apply profile (needs root)"
    echo "  status              Show full engine status"
    echo "  policy              Show policy engine status"
    echo "  backup              Backup current state"
    echo "  restore <dir>       Restore from backup"
    echo ""
    echo "Engine Commands:"
    echo "  cpu <action>        CPU engine"
    echo "  memory <action>     Memory engine"
    echo "  gpu <action>        GPU engine"
    echo "  io <action>         IO engine"
    echo "  network <action>    Network engine"
    echo "  thermal <action>    Thermal engine"
    echo "  game <action>       Game detection"
    echo "  refreshrate <a>     Global refresh rate control (set/reduced/lock/unlock/status)"
    echo "  dvfs <action>       Advanced DVFS limiter (cpu/gpu % cap)"
    echo "  framelimit <a>      System-wide frame rate limit disable/restore/status"
    echo "  surfaceflinger <a>  SurfaceFlinger tweak enable/disable/status"
    echo ""
    echo "Extreme Mode:"
    echo "  extreme enable      Enable extreme mode (opt-in)"
    echo "  extreme disable     Disable extreme mode"
    echo "  extreme status      Show extreme status"
    echo ""
    echo "Diagnostics:"
    echo "  doctor              Check for conflicts"
    echo "  export              Generate capability report"
    echo "  logs [type]         Show logs (boot/apply/rollback/error)"
    echo "  thermal-test        Quick thermal scan"
    echo ""
    echo "Profiles:"
    echo "  battery             Maximum battery savings"
    echo "  balanced            Default balanced mode"
    echo "  performance         Performance optimized"
    echo "  extreme             Maximum performance (opt-in)"
    echo ""
    echo "Examples:"
    echo "  hsin detect                     # View hardware info"
    echo "  hsin scan                       # Full capability scan"
    echo "  hsin apply performance          # Apply performance profile"
    echo "  hsin cpu state                  # Show CPU state"
    echo "  hsin gpu detect                 # Detect GPU"
    echo "  hsin thermal-test               # Quick thermal scan"
    echo "  hsin doctor                     # Check for conflicts"
    echo "  hsin logs                       # Show all logs"
    echo ""
}

# Main dispatcher
_main() {
    _cmd="${1:-help}"
    shift 2>/dev/null

    case "$_cmd" in
        detect)
            . "$HSIN_MODULE_PATH/core/hardware.sh" 2>/dev/null
            hsin_hardware_info
            ;;
        scan)
            . "$HSIN_MODULE_PATH/core/capability_scan.sh" 2>/dev/null
            hsin_scan
            ;;
        apply)
            _profile="${1:-balanced}"
            sh "$HSIN_MODULE_PATH/action.sh" apply "$_profile"
            ;;
        status)
            echo "=== HSIN STATUS ==="
            echo "Module: $HSIN_MODULE_PATH"
            echo "Data:   $HSIN_DATA"
            [ -f "$HSIN_DATA/service.state" ] && echo "Service: $(cat "$HSIN_DATA/service.state" 2>/dev/null)"
            [ -f "$HSIN_DATA/current_profile" ] && echo "Profile: $(cat "$HSIN_DATA/current_profile" 2>/dev/null)"
            [ -f "$HSIN_DATA/device.txt" ] && {
                echo "--- DEVICE ---"
                grep -E '^(SOC|VENDOR|GPU|KERNEL|ANDROID|SDK|ARCH|RAM_KB|ZRAM|THERMAL|CORES_ON|GOVS|TCP_CUR)=' \
                    "$HSIN_DATA/device.txt" 2>/dev/null | sed 's/^/  /'
            }
            [ -f "$HSIN_DATA/capability.json" ] && {
                echo "--- CAPABILITY ---"
                grep -E '"status"' "$HSIN_DATA/capability.json" 2>/dev/null | sed 's/^/  /'
            }
            ;;
        policy)
            . "$HSIN_MODULE_PATH/core/policy_engine.sh" 2>/dev/null
            hsin_policy_status
            ;;
        backup)
            . "$HSIN_MODULE_PATH/core/backup.sh" 2>/dev/null
            hsin_backup_all "manual_$(date '+%Y%m%d_%H%M%S')"
            ;;
        restore)
            . "$HSIN_MODULE_PATH/core/rollback.sh" 2>/dev/null
            if [ -n "$1" ]; then
                hsin_rollback_session "$1"
            else
                hsin_rollback_all
            fi
            ;;
        cpu)
            . "$HSIN_MODULE_PATH/engine/cpu/apply.sh" 2>/dev/null
            hsin_cpu_main "$@"
            ;;
        memory)
            . "$HSIN_MODULE_PATH/engine/memory/apply.sh" 2>/dev/null
            hsin_mem_main "$@"
            ;;
        gpu)
            . "$HSIN_MODULE_PATH/engine/gpu/apply.sh" 2>/dev/null
            hsin_gpu_main "$@"
            ;;
        io)
            . "$HSIN_MODULE_PATH/engine/io/io_manager.sh" 2>/dev/null
            hsin_io_main "$@"
            ;;
        network)
            . "$HSIN_MODULE_PATH/engine/network/network_manager.sh" 2>/dev/null
            hsin_network_main "$@"
            ;;
        thermal)
            . "$HSIN_MODULE_PATH/engine/thermal/thermal_manager.sh" 2>/dev/null
            hsin_thermal_main "$@"
            ;;
        thermal-test)
            . "$HSIN_MODULE_PATH/engine/thermal/apply.sh" 2>/dev/null
            hsin_thermal_test
            ;;
        game)
            . "$HSIN_MODULE_PATH/engine/game/game_manager.sh" 2>/dev/null
            hsin_game_main "$@"
            ;;
        refreshrate)
            . "$HSIN_MODULE_PATH/engine/display/refresh_rate.sh" 2>/dev/null
            _rr_action="${1:-status}"
            shift 2>/dev/null
            case "$_rr_action" in
                set) hsin_refresh_set_range "$1" "$2" "${3:-false}" ;;
                reduced) hsin_refresh_reduced_apply "$1" "${2:-false}" ;;
                lock) hsin_refresh_lock "$1" ;;
                unlock|disable) hsin_refresh_global_disable ;;
                status) hsin_refresh_status "$1" "$2" ;;
                *) echo "Usage: hsin refreshrate <set|reduced|lock|unlock|status> [args]" ;;
            esac
            ;;
        dvfs)
            . "$HSIN_MODULE_PATH/engine/gpu/dvfs.sh" 2>/dev/null
            hsin_dvfs_main "$@"
            ;;
        framelimit)
            . "$HSIN_MODULE_PATH/engine/display/frame_limit.sh" 2>/dev/null
            hsin_frame_limit_main "$@"
            ;;
        surfaceflinger)
            . "$HSIN_MODULE_PATH/engine/render/surfaceflinger.sh" 2>/dev/null
            hsin_sf_main "$@"
            ;;
        render)
            . "$HSIN_MODULE_PATH/core/runtime.sh" 2>/dev/null
            hsin_render_main "$@"
            ;;
        extreme)
            _action="${1:-status}"
            case "$_action" in
                enable)
                    echo "Enabling extreme mode..."
                    # Delegate to the real apply flow (same path as
                    # `hsin apply extreme`) so this actually wires the
                    # freq unlock / GPU override / thermal override /
                    # safety monitor - it used to just print a message
                    # and do nothing. ALLOW_EXTREME=true is exported for
                    # this one call only (session opt-in), it does not
                    # persist to hsin.conf.
                    ALLOW_EXTREME=true sh "$HSIN_MODULE_PATH/action.sh" apply extreme
                    ;;
                disable)
                    . "$HSIN_MODULE_PATH/extreme/safety_monitor.sh" 2>/dev/null
                    hsin_safety_monitor_stop
                    . "$HSIN_MODULE_PATH/extreme/restore_extreme.sh" 2>/dev/null
                    hsin_extreme_restore
                    ;;
                status)
                    echo ""
                    echo "Extreme Mode: $([ -f "$HSIN_DATA/extreme_active" ] && echo "ACTIVE" || echo "INACTIVE")"
                    echo ""
                    ;;
                *)
                    echo "Usage: hsin extreme [enable|disable|status]"
                    ;;
            esac
            ;;
        doctor)
            . "$HSIN_MODULE_PATH/core/doctor.sh" 2>/dev/null
            hsin_doctor_report
            ;;
        export)
            . "$HSIN_MODULE_PATH/core/export.sh" 2>/dev/null
            hsin_export_report
            hsin_export_print
            ;;
        logs)
            . "$HSIN_MODULE_PATH/core/logger.sh" 2>/dev/null
            _type="${1:-all}"
            case "$_type" in
                boot|apply|rollback|error)
                    hsin_log_print "$_type"
                    ;;
                all|*)
                    hsin_log_print_all
                    ;;
            esac
            ;;
        version)
            echo "HSIN Universal Adaptive Performance Engine v${HSIN_VERSION}"
            ;;
        help|*)
            hsin_help
            ;;
    esac
}

_main "$@"

return 0 2>/dev/null || true
export -f hsin_main 2>/dev/null
